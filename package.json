    "watch": "node --env-file-if-exists=.env watch.js"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "luxon": "3.7.2",
    "muhammara": "6.0.6",
    "playwright": "1.64.1"
  }
}
