{
  "name": "gehrimed-export-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Exports signed GEHRIMed encounter-note PDFs into date folders for billing (live mode + catch-up).",
  "scripts": {
